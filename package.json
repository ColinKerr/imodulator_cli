{
  "name": "imodulator-cli",
  "version": "0.2.0",
  "description": "iModulator CLI tool (imod) for working with iTwin.js iModels",
  "type": "commonjs",
  "bin": {
    "imod": "./dist/imod.js"
  },
  "main": "./dist/imod.js",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "imod": "node ./dist/imod.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.0.0 <23 || >=24.0.0 <25"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@itwin/core-backend": "^5.12.0",
    "@itwin/core-bentley": "^5.12.0",
    "@itwin/core-common": "^5.12.0",
    "@itwin/ecschema-editing": "^5.12.0",
    "@itwin/ecschema-locaters": "^5.12.0",
    "@itwin/ecschema-metadata": "^5.12.0",
    "@itwin/ecschema-rpcinterface-common": "^5.12.0",
    "@itwin/ecschema-rpcinterface-impl": "^5.12.0",
    "@itwin/imodels-access-backend": "^6.1.2",
    "@itwin/imodels-client-authoring": "^6.2.1",
    "@itwin/imodels-client-management": "^6.2.1",
    "@itwin/node-cli-authorization": "^3.1.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/yargs": "^17.0.33",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@bentley/imodeljs-native@5.12.28": true,
    "better-sqlite3@13.0.3": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true
  }
}
