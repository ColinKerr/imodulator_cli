{
  "name": "imodulator-cli",
  "version": "0.1.0",
  "description": "iModulator CLI tool (imod) for working with iTwin.js iModels",
  "type": "commonjs",
  "bin": {
    "imod": "./dist/imod.js"
  },
  "main": "./dist/imod.js",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "imod": "node ./dist/imod.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0 <21 || >=22.0.0 <23"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@itwin/core-backend": "^5.0.0",
    "@itwin/core-bentley": "^5.0.0",
    "@itwin/core-common": "^5.0.0",
    "@itwin/ecschema-editing": "^5.0.0",
    "@itwin/ecschema-locaters": "^5.0.0",
    "@itwin/ecschema-metadata": "^5.0.0",
    "@itwin/ecschema-rpcinterface-common": "^5.0.0",
    "@itwin/ecschema-rpcinterface-impl": "^5.0.0",
    "@itwin/imodels-access-backend": "^6.0.0",
    "@itwin/imodels-client-management": "^6.0.0",
    "@itwin/node-cli-authorization": "^3.0.0",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^17.0.0",
    "express": "^4.21.2",
    "keytar": "^7.9.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/yargs": "^17.0.33",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
