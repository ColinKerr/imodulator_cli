{
  "name": "imodulator-cli",
  "version": "0.1.0",
  "description": "iModulator CLI tool (imod) for working with iTwin.js iModels",
  "type": "commonjs",
  "bin": {
    "imod": "./dist/imod.js"
  },
  "main": "./dist/imod.js",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "imod": "node ./dist/imod.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.0.0 <23 || >=24.0.0 <25"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@itwin/core-backend": "^5.12.4",
    "@itwin/core-bentley": "^5.12.4",
    "@itwin/core-common": "^5.12.4",
    "@itwin/ecschema-editing": "^5.12.4",
    "@itwin/ecschema-locaters": "^5.12.4",
    "@itwin/ecschema-metadata": "^5.12.4",
    "@itwin/ecschema-rpcinterface-common": "^5.12.4",
    "@itwin/ecschema-rpcinterface-impl": "^5.12.4",
    "@itwin/imodel-transformer": "2.0.0-dev.50",
    "@itwin/imodels-access-backend": "^6.1.3",
    "@itwin/imodels-client-management": "^6.2.2",
    "@itwin/node-cli-authorization": "^3.1.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "keytar": "^7.9.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/yargs": "^17.0.33",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  },
  "allowScripts": {
    "keytar@7.9.0": true,
    "@bentley/imodeljs-native@5.12.31": true,
    "protobufjs@7.6.5": true,
    "esbuild@0.28.2": true
  }
}
