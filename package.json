{
  "name": "imodulator-cli",
  "version": "0.4.0",
  "description": "iModulator CLI tool (imod) for working with iTwin.js iModels",
  "main": "./dist/imod.js",
  "bin": {
    "imod": "./dist/imod.js"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "npm run ui:build && tsc && npm run build:web",
    "ui:install": "npm --prefix query-agent-ui install",
    "ui:build": "npm --prefix query-agent-ui run build",
    "ui:test": "npm --prefix query-agent-ui test",
    "clean": "rimraf dist",
    "imod": "node ./dist/imod.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:web": "vite build",
    "lint:web": "tsc -p tsconfig.web.json",
    "sync:ecsql-help": "node scripts/sync-ecsql-help.mjs"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@azure/storage-blob": "^12.34.0",
    "@itwin/core-backend": "^5.15.0",
    "@itwin/core-bentley": "^5.15.0",
    "@itwin/core-common": "^5.15.0",
    "@itwin/core-frontend": "^5.15.0",
    "@itwin/ecschema-editing": "^5.15.0",
    "@itwin/ecschema-locaters": "^5.15.0",
    "@itwin/ecschema-metadata": "^5.15.0",
    "@itwin/ecschema-rpcinterface-common": "^5.15.0",
    "@itwin/ecschema-rpcinterface-impl": "^5.15.0",
    "@itwin/imodel-transformer": "2.0.0-dev.81",
    "@itwin/imodels-access-backend": "^6.1.3",
    "@itwin/imodels-client-authoring": "^6.2.2",
    "@itwin/imodels-client-management": "^6.2.2",
    "@itwin/node-cli-authorization": "^3.1.1",
    "@itwin/object-storage-azure": "^3.1.3",
    "@itwin/object-storage-core": "^3.1.3",
    "@itwin/object-storage-google": "^3.1.3",
    "@itwin/presentation-backend": "^5.15.0",
    "@itwin/presentation-common": "^5.15.0",
    "@query-agent/client": "file:./query-agent-ui/packages/client",
    "@query-agent/react": "file:./query-agent-ui/packages/react",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "monaco-editor": "^0.56.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/yargs": "^17.0.33",
    "global-jsdom": "^26.0.0",
    "jsdom": "^26.1.0",
    "marked": "^14.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@openid/appauth": "1.3.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "@bentley/imodeljs-native@5.14.55": true,
    "protobufjs@7.6.6": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
