{
  "name": "@query-agent/client",
  "version": "0.1.0",
  "description": "The query agent's client library: runs the agent's queries on the host's iModel, and drives the turns with the agent function.",
  "license": "MIT",
  "private": true,
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./node": {
      "types": "./dist/cjs/node/index.d.ts",
      "require": "./dist/cjs/node/index.js"
    },
    "./startup-queries.json": "./dist/cjs/startup-queries.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json"
  },
  "peerDependencies": {
    "@itwin/core-common": "^5.14.2",
    "@itwin/core-frontend": "^5.14.2",
    "global-jsdom": "^26.0.0",
    "jsdom": "^26.1.0"
  },
  "peerDependenciesMeta": {
    "@itwin/core-common": {
      "optional": true
    },
    "@itwin/core-frontend": {
      "optional": true
    },
    "global-jsdom": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    }
  }
}
